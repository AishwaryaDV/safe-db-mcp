# Copy to .env and fill in. Secrets only; non-secret settings live in config.yaml.
# None of these are needed until the eval harness (P5); P1-P4 run without any keys.

# LLM backend: claude_sdk (local Claude Code login, dev) | gemini (free tier, deployed)
LLM_BACKEND=claude_sdk
# LLM mode: live (call model) | record (call and cache) | replay (cache only; CI uses this)
LLM_MODE=replay
# Gemini free-tier key, used only when LLM_BACKEND=gemini
GEMINI_API_KEY=
# Max live model requests per day before the quota guard refuses
DAILY_LLM_BUDGET=200
# Error hints in tool responses: on | off (off is an eval experiment, P6)
HINTS=on
