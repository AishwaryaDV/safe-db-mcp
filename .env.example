# Copy to .env and fill in. .env is gitignored — your key never gets committed.
#
# Pick which model drives the agent (the "Try it" demo + the eval harness). The MCP server
# itself needs no key; this is only for the parts of the repo that call a model.
#
#   claude_sdk    - a local Claude Code / `claude login` session (no key; for local dev only)
#   anthropic_api - your own Anthropic API key  (ANTHROPIC_API_KEY below)   <-- bring your own
#   gemini        - your own Gemini API key     (GEMINI_API_KEY below)
LLM_BACKEND=anthropic_api

# live = call the model, replay = cached only (no key needed), record = call + cache
LLM_MODE=live

# Your keys. Leave blank for the backend you are not using.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Comma-separated origins allowed to call the API (empty = allow all). Set in production.
ALLOWED_ORIGINS=
